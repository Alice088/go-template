# Copy to .env and fill in the values: cp .env.example .env
#
# Generate a signing key with:
#   openssl rand -hex 32
# The application refuses to start while JWT_SECRET_KEY is the placeholder.

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_HEADER_TIMEOUT=5s
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=60s
SERVER_REQUEST_TIMEOUT=30s
SERVER_SHUTDOWN_TIMEOUT=10s
SERVER_MAX_BODY_BYTES=1048576
SERVER_ALLOWED_ORIGINS=*

# Database
# docker compose uses these values to configure the postgres service, so the
# application and the container always agree.
DB_HOST=localhost
DB_PORT=5432
DB_USER=gotemplate
DB_PASSWORD=gotemplate
DB_NAME=gotemplate
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# Logging: level is debug|info|warn|error, format is json|pretty
LOG_LEVEL=info
LOG_FORMAT=json

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
